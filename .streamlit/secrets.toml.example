# Copia este fichero a .streamlit/secrets.toml para desarrollo local,
# o pega el contenido en el panel de Secrets de Streamlit Community Cloud.

# --- ID del Google Sheet ---
GOOGLE_SHEET_ID = "1_rn_2CTc8yEcnZUUei-ytKAEW0lph3QeUKojCS3WRd8"

# --- Nombres de pestañas (defaults razonables, ajusta si tu sheet difiere) ---
SHEET_TAB_MERCADO = "mercado"
SHEET_TAB_RECOMENDACIONES = "Recomendaciones"
SHEET_TAB_RECOMENDACIONES_RESUMEN = "Recomendaciones_Resumen"
SHEET_TAB_HUECOS_FAMILIA = "Huecos_Familia"
SHEET_TAB_HUECOS_SUBFAMILIA = "Huecos_Subfamilia"
SHEET_TAB_HUECOS_PRODUCTOS = "Huecos_Productos"

# Estas dos pestañas las crea la app cuando se toma la primera decisión
SHEET_TAB_DECISIONES_PRICING = "Decisiones_Pricing"
SHEET_TAB_DECISIONES_SURTIDO = "Decisiones_Surtido"

# --- Credenciales del service account ---
# Pega aquí el contenido de tu google_credentials.json. CADA campo va como clave TOML.
[gcp_service_account]
type = "service_account"
project_id = "agente-farmacia-496411"
private_key_id = "REPLACE_WITH_YOUR_PRIVATE_KEY_ID"
private_key = """-----BEGIN PRIVATE KEY-----
REPLACE_WITH_YOUR_MULTILINE_PRIVATE_KEY
-----END PRIVATE KEY-----
"""
client_email = "agente-farmacia-bot@agente-farmacia-496411.iam.gserviceaccount.com"
client_id = "REPLACE_WITH_YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "REPLACE_WITH_YOUR_CERT_URL"
universe_domain = "googleapis.com"
